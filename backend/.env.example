# Supabase project settings. Keep the database URL private; publishable keys are safe in the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:REPLACE_ME@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SANKET_BOOTSTRAP_COORDINATOR_EMAIL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ALLOWED_ORIGINS=http://localhost:8088
SANKET_PORT=8088

# Optional local-only token compatibility for automated demos; leave disabled in deployment.
# SANKET_DEMO_TOKENS=true
# COORDINATOR_TOKEN=
# RESPONDER_TOKEN=
